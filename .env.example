# Public site URL for absolute metadata (Open Graph, canonical URLs)
NEXT_PUBLIC_SITE_URL=https://mkf.example.org

# Public Givebutter campaign / donation form URL (fallback if no “active donate” event in Admin).
# NEXT_PUBLIC_GIVEBUTTER_URL=https://givebutter.com/c/your-campaign

# ——— Auth.js (NextAuth v5) ———
# 32+ random bytes, e.g. `openssl rand -base64 32`
AUTH_SECRET=

# App URL (required in production), e.g. http://localhost:3000
AUTH_URL=http://localhost:3000

# ——— MongoDB ———
MONGODB_URI=mongodb+srv://user:pass@cluster.example.mongodb.net
MONGODB_DB=mkf

# ——— ImageKit (admin uploads; public read via CDN) ———
# IMAGEKIT_PUBLIC_KEY=
# IMAGEKIT_PRIVATE_KEY=
# IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
